{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/server/memb.exe\" hook prompt-submit --cli codex",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/server/memb.exe\" hook assistant-stop --cli codex",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
